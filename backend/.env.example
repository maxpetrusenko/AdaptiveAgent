ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
MODEL_PROVIDER=auto

# Metadata-only Langfuse tracing. Content is masked by default.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Native Rust hybrid retrieval.
KNOWLEDGE_INDEX_PATH=./knowledge-index
# Use "openai" for real semantic embeddings; "deterministic" is a local fixture.
KNOWLEDGE_EMBEDDING_PROVIDER=deterministic
KNOWLEDGE_EMBEDDING_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIMENSIONS=768

# Durable autonomous research proof runs.
RESEARCH_DATABASE_PATH=./research.db
# Enables controlled crash injection; keep false outside local proof environments.
RESEARCH_PROOF_MODE=false

# Required for non-loopback operator mutations in deployed environments.
OPERATOR_API_TOKEN=
